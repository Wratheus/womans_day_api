							"host": ["{{baseUrl}}"],
							"path": ["internal", "monitor", "health"]
						}
					}
				},
				{
					"name": "Info",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/internal/monitor/info",
							"host": ["{{baseUrl}}"],
							"path": ["internal", "monitor", "info"]
						}
					}
				},
				{
					"name": "HTTP Exchanges (dev only)",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/internal/monitor/httpexchanges",
							"host": ["{{baseUrl}}"],
							"path": ["internal", "monitor", "httpexchanges"]
						}
					}
				}
			]
		}
	]
}
