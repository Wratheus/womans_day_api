		{
			"name": "Tasks",
			"item": [
				{
					"name": "Get All Tasks",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/tasks",
							"host": ["{{baseUrl}}"],
							"path": ["api", "tasks"]
						},
						"description": "Get all tasks with current user's submission status."
					}
				},
				{
					"name": "Get Task by ID",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/tasks/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "tasks", "1"]
						},
						"description": "Get a single task with current user's submission details."
					}
				},
				{
					"name": "Submit Task (solo)",
					"request": {
						"method": "POST",
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "text", "value": "My answer text", "type": "text" },
								{ "key": "files", "type": "file", "src": "" }
							]
						},
						"url": {
							"raw": "{{baseUrl}}/api/tasks/1/submit",
							"host": ["{{baseUrl}}"],
							"path": ["api", "tasks", "1", "submit"]
						},
						"description": "Solo submission. Status immediately becomes `pending`."
					}
				},
				{
					"name": "Submit Task (collaborative)",
					"request": {
						"method": "POST",
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "text", "value": "Our team answer", "type": "text" },
								{ "key": "files", "type": "file", "src": "" },
								{ "key": "participantIds", "value": "2", "type": "text" },
								{ "key": "participantIds", "value": "3", "type": "text" }
							]
						},
						"url": {
							"raw": "{{baseUrl}}/api/tasks/1/submit",
							"host": ["{{baseUrl}}"],
							"path": ["api", "tasks", "1", "submit"]
						},
						"description": "Collaborative submission. Status becomes `waitingForParticipants` until all invited users accept."
					}
				},
				{
					"name": "Accept Invitation",
					"request": {
						"method": "POST",
						"url": {
							"raw": "{{baseUrl}}/api/tasks/submissions/1/respond?accept=true",
							"host": ["{{baseUrl}}"],
							"path": ["api", "tasks", "submissions", "1", "respond"],
							"query": [
								{ "key": "accept", "value": "true" }
							]
						},
						"description": "Accept a co-participation invitation. When all accept, status becomes `pending`."
					}
				},
				{
					"name": "Decline Invitation",
					"request": {
						"method": "POST",
						"url": {
							"raw": "{{baseUrl}}/api/tasks/submissions/1/respond?accept=false",
							"host": ["{{baseUrl}}"],
							"path": ["api", "tasks", "submissions", "1", "respond"],
							"query": [
								{ "key": "accept", "value": "false" }
							]
						},
						"description": "Decline a co-participation invitation. If all decline, submission is `cancelled`."
					}
				},
				{
					"name": "Cancel Submission",
					"request": {
						"method": "DELETE",
						"url": {
							"raw": "{{baseUrl}}/api/tasks/submissions/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "tasks", "submissions", "1"]
						},
						"description": "Cancel own submission (submitter only)."
					}
				},
				{
					"name": "Get Budget",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/tasks/budget",
							"host": ["{{baseUrl}}"],
							"path": ["api", "tasks", "budget"]
						},
						"description": "Get total and approved budget. Available to all authenticated users."
					}
				},
				{
					"name": "Get File",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/tasks/files/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "tasks", "files", "1"]
						},
						"description": "Get submission file by ID. Users can only access files from their own submissions. Admin can access all."
					}
				}
			]
		},
