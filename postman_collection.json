{
	"info": {
		"name": "Womans Day API",
		"description": "API для корпоративного приложения к 8 марта",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080/api"
		},
		{
			"key": "token",
			"value": ""
		},
		{
			"key": "adminToken",
			"value": ""
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var json = pm.response.json();",
									"if (json.token) {",
									"    pm.collectionVariables.set('token', json.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"login\": \"masha\",\n    \"password\": \"1234\",\n    \"department\": \"Бухгалтерия\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "register"]
						}
					}
				},
				{
					"name": "Login (User)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var json = pm.response.json();",
									"if (json.token) {",
									"    pm.collectionVariables.set('token', json.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"login\": \"masha\",\n    \"password\": \"1234\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "Login (Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var json = pm.response.json();",
									"if (json.token) {",
									"    pm.collectionVariables.set('adminToken', json.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"login\": \"admin\",\n    \"password\": \"admin\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"url": {
							"raw": "{{baseUrl}}/auth/logout",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "logout"]
						}
					}
				}
			]
		},
		{
			"name": "Tasks",
			"item": [
				{
					"name": "Get All Tasks",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/tasks",
							"host": ["{{baseUrl}}"],
							"path": ["tasks"]
						}
					}
				},
				{
					"name": "Get Task by ID",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/tasks/1",
							"host": ["{{baseUrl}}"],
							"path": ["tasks", "1"]
						}
					}
				},
				{
					"name": "Submit Text Answer",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "text",
									"value": "Ты лучшая коллега!",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/tasks/2/submit",
							"host": ["{{baseUrl}}"],
							"path": ["tasks", "2", "submit"]
						}
					}
				},
				{
					"name": "Submit Photo Answer",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "photos",
									"type": "file",
									"src": ""
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/tasks/1/submit",
							"host": ["{{baseUrl}}"],
							"path": ["tasks", "1", "submit"]
						}
					}
				},
				{
					"name": "Submit Text + Photo Answer",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "text",
									"value": "Букет для Марии из отдела продаж",
									"type": "text"
								},
								{
									"key": "photos",
									"type": "file",
									"src": ""
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/tasks/3/submit",
							"host": ["{{baseUrl}}"],
							"path": ["tasks", "3", "submit"]
						}
					}
				},
				{
					"name": "Get Budget",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/tasks/budget",
							"host": ["{{baseUrl}}"],
							"path": ["tasks", "budget"]
						}
					}
				},
				{
					"name": "Get Photo",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/tasks/photos/1",
							"host": ["{{baseUrl}}"],
							"path": ["tasks", "photos", "1"]
						}
					}
				}
			]
		},
		{
			"name": "Admin",
			"item": [
				{
					"name": "Review Submission (Approve)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{adminToken}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userId\": 2,\n    \"approved\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/tasks/2/review",
							"host": ["{{baseUrl}}"],
							"path": ["tasks", "2", "review"]
						}
					}
				},
				{
					"name": "Review Submission (Reject)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{adminToken}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userId\": 2,\n    \"approved\": false\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/tasks/1/review",
							"host": ["{{baseUrl}}"],
							"path": ["tasks", "1", "review"]
						}
					}
				}
			]
		}
	]
}
